# ============================================================================
# SPNpeet POS — Environment Template
# Copy to `.env` at the repo root. NEVER commit the populated `.env`.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL / Supabase Database
# When running locally via docker-compose, the `db` service is used.
# In production, point this at your Supabase Postgres connection string
# (use the *session* pooler / direct connection for SELECT ... FOR UPDATE).
# ----------------------------------------------------------------------------
POSTGRES_USER=spnpeet
POSTGRES_PASSWORD=supersecret_change_me
POSTGRES_DB=spnpeet_pos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN consumed by the Golang API (pgx pool).
DATABASE_URL=postgres://spnpeet:supersecret_change_me@db:5432/spnpeet_pos?sslmode=disable

# ----------------------------------------------------------------------------
# Golang Transaction Engine (api)
# ----------------------------------------------------------------------------
API_PORT=8080
API_ENV=development
# Max/min connections for the pgx pool.
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2
# Pessimistic lock wait timeout (ms) before a checkout aborts with LOCK_TIMEOUT.
DB_LOCK_TIMEOUT_MS=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase Auth (JWT verification)
# The API verifies Supabase-issued JWTs using the project's JWT secret.
# Find it in: Supabase Dashboard -> Project Settings -> API -> JWT Secret.
# ----------------------------------------------------------------------------
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Next.js PWA (web)  — only NEXT_PUBLIC_* vars reach the browser
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8080
